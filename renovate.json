{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "baseBranchPatterns": [
    "main"
  ],
  "prHourlyLimit": 0,
  "prConcurrentLimit": 0,
  "branchConcurrentLimit": 0,
  "mode": "full",
  "commitMessageLowerCase": "auto",
  "semanticCommits": "enabled",
  "ignoreUnstable": false,
  "argocd": {
    "managerFilePatterns": [
      "/^.*argo\\.yaml$/"
    ]
  },
  "flux": {
    "managerFilePatterns": [
      "/^.*flux\\.yaml$/"
    ]
  },
  "terraform": {
    "enabled": false
  }
}
